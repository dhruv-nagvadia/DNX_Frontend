# This project uses THREE per-environment files instead of a single `.env`:
#   .env.development  (npm run dev           / npm run build          — default mode)
#   .env.staging      (npm run dev:staging   / npm run build:staging)
#   .env.production   (npm run dev:production/ npm run build:production)
# All three are committed (they only hold a non-secret API URL) — this file is
# just a reference template, kept for anyone bootstrapping a fresh one.
#
# Vite exposes only vars prefixed with VITE_ to the client (import.meta.env).
VITE_API_BASE_URL=http://localhost:4000/api/v1
